{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "khlun-music",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khlun-music",
      "database_id": "dae6c4de-3723-4682-ae26-e2190999acbe",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "khlun-music-audio"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
